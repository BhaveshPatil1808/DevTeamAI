async function handleChat(req, res) {
    if (Date.now() - windowStarted >= CHAT_WINDOW_MS) {
        requestCount = 0;
        windowStarted = Date.now();
    }

    if (++requestCount > MAX_CHAT_REQUESTS) {
        return sendJSON(res, 429, {
            success: false,
            error: "Too many requests. Please wait a minute."
        });
    }

    let body;

    try {
        body = await readBody(req);
    } catch (error) {
        return sendJSON(res, 400, {
            success: false,
            error: error.message
        });
    }

    const message = body.message;

    if (typeof message !== "string" || !message.trim()) {
        return sendJSON(res, 400, {
            success: false,
            error: "Please enter a project request."
        });
    }

    if (message.length > 8000) {
        return sendJSON(res, 400, {
            success: false,
            error: "Message is too long. Maximum 8000 characters."
        });
    }

    try {
        const result = await askWithFallback(
            message.trim(),
            getProjectManagerPrompt(),
            {
                maxTokens: 2500,
                temperature: 0.3,
                timeout: 120000,
                reasoningEffort: "low"
            }
        );

        return sendJSON(res, 200, {
            success: true,
            reply: result.content,
            model: result.model,
            usage: result.usage,
            provider: result.provider || null
        });

    } catch (error) {
        console.error("[AI CHAT ERROR]", error.message);

        return sendJSON(res, 502, {
            success: false,
            error: "AI request failed. Please try again."
        });
    }
}


function slugifyProjectName(value) {
    return String(value)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "")
        .slice(0, 50);
}

function isTerminalProjectStatus(status) {
    return [
        "integration_completed",
        "partially_completed",
        "failed",
        "integration_failed",
        "qa_failed"
    ].includes(status);
}

async function handleProjectRun(req, res) {
    if (projectRunActive) {
        return sendJSON(res, 409, {
            success: false,
            error: "Another project run is already in progress."
        });
    }

    let body;

    try {
        body = await readBody(req);
    } catch (error) {
        return sendJSON(res, 400, {
            success: false,
            error: error.message
        });
    }

    const projectName = body.projectName;
    const description = body.description;

    if (
        typeof projectName !== "string" ||
        !projectName.trim() ||
        projectName.length > 80
    ) {
        return sendJSON(res, 400, {
            success: false,
            error: "Provide a project name of at most 80 characters."
        });
    }

    if (
        typeof description !== "string" ||
        !description.trim() ||
        description.length > 8000
    ) {
        return sendJSON(res, 400, {
            success: false,
            error: "Provide a project description of at most 8000 characters."
        });
    }

    const cleanName = projectName.trim();
    const cleanDescription = description.trim();
    const projectSlug = slugifyProjectName(cleanName);

    if (!projectSlug) {
        return sendJSON(res, 400, {
            success: false,
            error: "Project name must contain letters or numbers."
        });
    }

    const runId = randomUUID();

    projectRunActive = true;
    activeRun = {
        runId,
        projectSlug,
        projectName: cleanName,
        startedAt: new Date().toISOString()
    };

    console.log("[DEVTEAM] Project execution accepted:", cleanName);
    console.log("[DEVTEAM] Run ID:", runId);

    // runProject persists its initial state before reaching its first await.
    // The dashboard can therefore poll immediately using this run ID.
    const execution = runProject({
        projectName: cleanName,
        description: cleanDescription,
        runId
    });

    execution
        .then(result => {
            console.log(
                `[DEVTEAM] Project finished: ${result.status} | ` +
                `Completed: ${result.completed}/${result.totalTasks} | ` +
                `QA: ${result.qaStatus}`
            );
        })
        .catch(error => {
            console.error("[DEVTEAM] Project run failed:", error.message);

            try {
                const projectRoot = getProjectRoot(projectSlug);
                const state = loadProjectState(projectRoot);

                if (state && state.runId === runId) {
                    state.status = "failed";
                    state.fatalError = error.message;
                    state.completedAt = new Date().toISOString();
                    state.updatedAt = new Date().toISOString();

                    saveProjectState(projectRoot, state);

                    recordEvent(projectRoot, {
                        type: "project.fatal_error",
                        runId,
                        error: error.message
                    });
                }
            } catch (stateError) {
                console.error(
                    "[DEVTEAM] Could not save fatal run status:",
                    stateError.message
                );
            }
        })
        .finally(() => {
            projectRunActive = false;
            activeRun = null;
        });

    return sendJSON(res, 202, {
        success: true,
        accepted: true,
        runId,
        projectName: cleanName,
        projectSlug,
        status: "planning"
    });
}

function handleProjectStatus(req, res, url) {
    const projectSlug = url.searchParams.get("projectSlug");
    const runId = url.searchParams.get("runId");

    if (
        !projectSlug ||
        !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(projectSlug) ||
        projectSlug.length > 50
    ) {
        return sendJSON(res, 400, {
            success: false,
            error: "Invalid project slug."
        });
    }

    if (
        !runId ||
        !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(runId)
    ) {
        return sendJSON(res, 400, {
            success: false,
            error: "Invalid run ID."
        });
    }

    try {
        const projectRoot = getProjectRoot(projectSlug);
        const state = loadProjectState(projectRoot);

        if (!state || state.runId !== runId) {
            return sendJSON(res, 404, {
                success: false,
                error: "Project run was not found."
            });
        }

        const tasks = Array.isArray(state.tasks) ? state.tasks : [];
        const completed = tasks.filter(task => task.status === "completed").length;
        const failed = tasks.filter(task => task.status === "failed").length;
        const skipped = tasks.filter(task => task.status === "skipped").length;

        return sendJSON(res, 200, {
            success: true,
            terminal: isTerminalProjectStatus(state.status),
            projectName: state.projectName,
            projectSlug: state.projectSlug,
            runId: state.runId,
            status: state.status,
            createdAt: state.createdAt,
            updatedAt: state.updatedAt,
            completedAt: state.completedAt || null,
            plan: state.plan ? {
                summary: state.plan.summary || "",
                technologyStack: state.plan.technologyStack || []
            } : null,
            progress: {
                total: tasks.length,
                completed,
                failed,
                skipped,
                running: tasks.filter(task => task.status === "running").length,
                pending: tasks.filter(task => task.status === "pending").length
            },
            tasks: tasks.map(task => ({
                id: task.id,
                title: task.title,
                agentId: task.agentId,
                status: task.status,
                error: task.error || null,
                result: task.result ? {
                    agentName: task.result.agentName,
                    summary: task.result.summary,
                    files: task.result.files || [],
                    model: task.result.model || null
                } : null
            })),
            generatedFiles: state.generatedFiles || [],
            integration: state.integration || { status: "pending" },
            qa: state.qa || { status: "pending" },
            fatalError: state.fatalError || null
        });
    } catch (error) {
        console.error("[DEVTEAM] Status lookup failed:", error.message);

        return sendJSON(res, 500, {
            success: false,
            error: "Unable to read project status."
        });
    }
}

function handleHealth(req, res) {
    return sendJSON(res, 200, {
        success: true,
        application: "DevTeamAI",
        status: "running",
        projectExecutionActive: projectRunActive,
        activeRun,
        providerOrder: getProviderOrder()
    });
}

function serveStaticFile(req, res, pathname) {
    if (pathname === "/") {
        pathname = "/index.html";
    }

    let decodedPath;

    try {
        decodedPath = decodeURIComponent(pathname);
    } catch {
        res.writeHead(400);
        return res.end("Bad request");
    }

    if (decodedPath.includes("\0")) {
        res.writeHead(400);
        return res.end("Bad request");
    }

    const filePath = path.resolve(PUBLIC_DIR, "." + decodedPath);

    if (!isInsideDirectory(PUBLIC_DIR, filePath)) {
        res.writeHead(403);
        return res.end("Forbidden");
    }

    fs.stat(filePath, (statError, stats) => {
        if (statError || !stats.isFile()) {
            res.writeHead(404);
            return res.end("File not found");
        }

        fs.readFile(filePath, (error, content) => {
            if (error) {
                res.writeHead(500);
                return res.end("Unable to read file");
            }

            res.writeHead(200, {
                "Content-Type":
                    MIME_TYPES[path.extname(filePath).toLowerCase()] ||
                    "application/octet-stream",
                "Cache-Control": "no-store",
                "X-Content-Type-Options": "nosniff"
            });

            if (req.method === "HEAD") {
                return res.end();
            }

            return res.end(content);
        });
    });
}

const server = http.createServer(async (req, res) => {
    let url;

    try {
        url = new URL(req.url, "http://localhost");
    } catch {
        return sendJSON(res, 400, {
            success: false,
            error: "Invalid request URL."
        });
    }

    if (url.pathname === "/api/health") {
        if (req.method !== "GET") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleHealth(req, res);
    }

    if (url.pathname === "/api/projects/run") {
        if (req.method !== "POST") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleProjectRun(req, res);
    }

    if (url.pathname === "/api/projects/status") {
        if (req.method !== "GET") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleProjectStatus(req, res, url);
    }

    if (url.pathname === "/api/chat") {
        if (req.method !== "POST") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleChat(req, res);
    }

    if (req.method !== "GET" && req.method !== "HEAD") {
        res.writeHead(405);
        return res.end("Method not allowed");
    }

    return serveStaticFile(req, res, url.pathname);
});

