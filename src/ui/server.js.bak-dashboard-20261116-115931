async function handleChat(req, res) {
    if (Date.now() - windowStarted >= CHAT_WINDOW_MS) {
        requestCount = 0;
        windowStarted = Date.now();
    }

    if (++requestCount > MAX_CHAT_REQUESTS) {
        return sendJSON(res, 429, {
            success: false,
            error: "Too many requests. Please wait a minute."
        });
    }

    let body;

    try {
        body = await readBody(req);
    } catch (error) {
        return sendJSON(res, 400, {
            success: false,
            error: error.message
        });
    }

    const message = body.message;

    if (typeof message !== "string" || !message.trim()) {
        return sendJSON(res, 400, {
            success: false,
            error: "Please enter a project request."
        });
    }

    if (message.length > 8000) {
        return sendJSON(res, 400, {
            success: false,
            error: "Message is too long. Maximum 8000 characters."
        });
    }

    try {
        const result = await askWithFallback(
            message.trim(),
            getProjectManagerPrompt(),
            {
                maxTokens: 2500,
                temperature: 0.3,
                timeout: 120000,
                reasoningEffort: "low"
            }
        );

        return sendJSON(res, 200, {
            success: true,
            reply: result.content,
            model: result.model,
            usage: result.usage,
            provider: result.provider || null
        });

    } catch (error) {
        console.error("[AI CHAT ERROR]", error.message);

        return sendJSON(res, 502, {
            success: false,
            error: "AI request failed. Please try again."
        });
    }
}

async function handleProjectRun(req, res) {
    if (projectRunActive) {
        return sendJSON(res, 409, {
            success: false,
            error: "Another project run is already in progress."
        });
    }

    let body;

    try {
        body = await readBody(req);
    } catch (error) {
        return sendJSON(res, 400, {
            success: false,
            error: error.message
        });
    }

    const projectName = body.projectName;
    const description = body.description;

    if (
        typeof projectName !== "string" ||
        !projectName.trim() ||
        projectName.length > 80
    ) {
        return sendJSON(res, 400, {
            success: false,
            error: "Provide a project name of at most 80 characters."
        });
    }

    if (
        typeof description !== "string" ||
        !description.trim() ||
        description.length > 8000
    ) {
        return sendJSON(res, 400, {
            success: false,
            error: "Provide a project description of at most 8000 characters."
        });
    }

    projectRunActive = true;

    console.log(
        "[DEVTEAM] Project execution requested:",
        projectName.trim()
    );

    try {
        const result = await runProject({
            projectName: projectName.trim(),
            description: description.trim()
        });

        const successful =
            result.status === "integration_completed" &&
            result.qaStatus === "passed";

        console.log(
            `[DEVTEAM] Project finished: ${result.status} | ` +
            `Completed: ${result.completed}/${result.totalTasks} | ` +
            `QA: ${result.qaStatus}`
        );

        return sendJSON(res, 200, {
            success: successful,
            result
        });

    } catch (error) {
        console.error("[DEVTEAM] Project run failed:", error.message);

        return sendJSON(res, 502, {
            success: false,
            error: error.message
        });

    } finally {
        projectRunActive = false;
    }
}

function handleHealth(req, res) {
    return sendJSON(res, 200, {
        success: true,
        application: "DevTeamAI",
        status: "running",
        projectExecutionActive: projectRunActive,
        providerOrder: getProviderOrder()
    });
}

function serveStaticFile(req, res, pathname) {
    if (pathname === "/") {
        pathname = "/index.html";
    }

    let decodedPath;

    try {
        decodedPath = decodeURIComponent(pathname);
    } catch {
        res.writeHead(400);
        return res.end("Bad request");
    }

    if (decodedPath.includes("\0")) {
        res.writeHead(400);
        return res.end("Bad request");
    }

    const filePath = path.resolve(PUBLIC_DIR, "." + decodedPath);

    if (!isInsideDirectory(PUBLIC_DIR, filePath)) {
        res.writeHead(403);
        return res.end("Forbidden");
    }

    fs.stat(filePath, (statError, stats) => {
        if (statError || !stats.isFile()) {
            res.writeHead(404);
            return res.end("File not found");
        }

        fs.readFile(filePath, (error, content) => {
            if (error) {
                res.writeHead(500);
                return res.end("Unable to read file");
            }

            res.writeHead(200, {
                "Content-Type":
                    MIME_TYPES[path.extname(filePath).toLowerCase()] ||
                    "application/octet-stream",
                "Cache-Control": "no-store",
                "X-Content-Type-Options": "nosniff"
            });

            if (req.method === "HEAD") {
                return res.end();
            }

            return res.end(content);
        });
    });
}

const server = http.createServer(async (req, res) => {
    let url;

    try {
        url = new URL(req.url, "http://localhost");
    } catch {
        return sendJSON(res, 400, {
            success: false,
            error: "Invalid request URL."
        });
    }

    if (url.pathname === "/api/health") {
        if (req.method !== "GET") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleHealth(req, res);
    }

    if (url.pathname === "/api/projects/run") {
        if (req.method !== "POST") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleProjectRun(req, res);
    }

    if (url.pathname === "/api/chat") {
        if (req.method !== "POST") {
            return sendJSON(res, 405, {
                success: false,
                error: "Method not allowed."
            });
        }

        return handleChat(req, res);
    }

    if (req.method !== "GET" && req.method !== "HEAD") {
        res.writeHead(405);
        return res.end("Method not allowed");
    }

    return serveStaticFile(req, res, url.pathname);
});

server.listen(PORT, "0.0.0.0", () => {
